# ── Model ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# ── Export mode ────────────────────────────────────────────────────────────────
# otlp    -> send spans to Agent Observability (the properly-instrumented case)
# console -> emit the app's own OTel spans to stdout, which AgentCore captures into
#            CloudWatch Logs. Demonstrates an app that really runs OTel but exports it
#            to a log sink, which is the input for recover-spans-from-logs.
# both    -> both, for side-by-side comparison
UNDERWRITING_EXPORT_MODE="otlp"

# Fraction of traces that deliberately exhibit a defect (skipped step, protected-
# characteristic rationale, unconditional promise, cross-applicant reference). Drives the
# spread in action-completeness and makes the agent-control gate actually fire.
UNDERWRITING_NOISE_RATE="0.35"

# ── Agent Observability (delian-league) ────────────────────────────────────────
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="https://api-tokenomics-delian.gcp-dev.galileo.ai/otel/v1/traces"
# Auth accepts any one of: Galileo-API-Key, Splunk-AO-API-Key, Bearer, HTTP Basic.
# project / logstream route the trace to the right place in the org.
OTEL_EXPORTER_OTLP_TRACES_HEADERS="Galileo-API-Key=<key>,project=ai-underwriting-pipeline,logstream=default"

OTEL_SERVICE_NAME="ai-underwriting-pipeline"
OTEL_RESOURCE_ATTRIBUTES="deployment.environment=aws-agentcore"

# ── Splunk GenAI instrumentation ───────────────────────────────────────────────
OTEL_INSTRUMENTATION_GENAI_EMITTERS="span_metric_event,splunk"
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT="true"
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT_MODE="SPAN_AND_EVENT"
OTEL_INSTRUMENTATION_GENAI_EVALS_RESULTS_AGGREGATION="true"
OTEL_INSTRUMENTATION_GENAI_EMITTERS_EVALUATION="replace-category:SplunkEvaluationResults"
# Leave GENAI_DEBUG off. It writes token counts to stdout as key=value, which is useful
# when nothing else works but repeats the same counts across every emitter in a composite
# dispatch -- a naive sum over those lines over-counts tokens by an order of magnitude.
OTEL_INSTRUMENTATION_GENAI_DEBUG="false"
