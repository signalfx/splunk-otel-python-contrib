AWS_REGION=us-west-2
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_PROMPT="Explain in two sentences how OpenTelemetry helps debug agentic AI."
BEDROCK_EXAMPLE_EXPORTER=otlp
BEDROCK_EXAMPLE_ENABLE_AGENTCORE=false
BEDROCK_EXAMPLE_SERVE_AGENTCORE=false
BEDROCK_EXAMPLE_EVAL_WAIT_SECONDS=60
OTEL_SERVICE_NAME=bedrock-runtime-agentcore-example
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_INSTRUMENTATION_GENAI_EMITTERS=span_metric_event
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT_MODE=SPAN_AND_EVENT

# Enable evals by installing the eval packages and uncommenting one of these.
# OTEL_INSTRUMENTATION_GENAI_EVALS_EVALUATORS=length(LLMInvocation(length))
# OTEL_INSTRUMENTATION_GENAI_EVALS_EVALUATORS=deepeval(LLMInvocation(toxicity,bias))
