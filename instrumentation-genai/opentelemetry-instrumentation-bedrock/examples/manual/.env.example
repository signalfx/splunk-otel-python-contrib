AWS_REGION=us-west-2
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_PROMPT="Explain in two sentences how OpenTelemetry helps debug agentic AI."
BEDROCK_EXAMPLE_EXPORTER=otlp
BEDROCK_EXAMPLE_ENABLE_AGENTCORE=false
BEDROCK_EXAMPLE_SERVE_AGENTCORE=false
BEDROCK_EXAMPLE_EVAL_WAIT_SECONDS=60
# BEDROCK_AGENTCORE_MEMORY_ID=your-memory-id
BEDROCK_AGENTCORE_MEMORY_NAME=bedrockRuntimeAgentCoreExampleMemory
BEDROCK_AGENTCORE_MEMORY_NAMESPACE=bedrock-runtime-agentcore-example
BEDROCK_AGENTCORE_MEMORY_ACTOR_ID=bedrock-runtime-agentcore-example-user
BEDROCK_AGENTCORE_MEMORY_SESSION_ID=bedrock-runtime-agentcore-example-session
BEDROCK_AGENTCORE_MEMORY_TOP_K=3
OTEL_SERVICE_NAME=bedrock-runtime-agentcore-example
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_INSTRUMENTATION_GENAI_EMITTERS=span_metric_event
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_AND_EVENT
DISABLE_ADOT_OBSERVABILITY=true

# Enable evals by uncommenting one of these.
# OTEL_INSTRUMENTATION_GENAI_EVALS_EVALUATORS=length(LLMInvocation(length))
# OTEL_INSTRUMENTATION_GENAI_EVALS_EVALUATORS=deepeval(LLMInvocation(toxicity,bias))
